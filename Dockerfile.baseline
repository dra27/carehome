FROM ocaml/opam:ubuntu-25.04-opam AS cache
ENV OPAMYES="1" OPAMCONFIRMLEVEL="unsafe-yes" OPAMERRLOGLEN="0" OPAMPRECISETRACKING="1"
RUN git -C opam-repository fetch origin && git -C opam-repository checkout $opam_repository && sudo ln -f /usr/bin/opam-2.4 /usr/bin/opam && opam update
RUN for v in $(seq 0 3); do opam source ocaml-config.$v; done
RUN opam source ocaml-base-compiler.3.07+2
RUN opam source ocaml-base-compiler.3.08.4
RUN opam source ocaml-base-compiler.3.09.3
RUN opam source ocaml-base-compiler.3.10.2
RUN opam source ocaml-base-compiler.3.11.2
RUN opam source ocaml-base-compiler.3.12.1
RUN opam source ocaml-base-compiler.4.00.1
RUN opam source ocaml-base-compiler.4.01.0
RUN opam source ocaml-base-compiler.4.02.3
RUN opam source ocaml-base-compiler.4.03.0
RUN opam source ocaml-base-compiler.4.04.2
RUN opam source ocaml-base-compiler.4.05.0
RUN opam source ocaml-base-compiler.4.06.1
RUN opam source ocaml-base-compiler.4.07.1
RUN opam source ocaml-base-compiler.4.08.1
RUN opam source ocaml-base-compiler.4.09.1
RUN opam source ocaml-base-compiler.4.10.2
RUN opam source ocaml-base-compiler.4.11.2
RUN opam source ocaml-base-compiler.4.12.1
RUN opam source ocaml-base-compiler.4.13.1
RUN opam source ocaml-base-compiler.4.14.2
RUN opam source ocaml-base-compiler.5.0.0
RUN opam source ocaml-base-compiler.5.1.1
RUN opam source ocaml-base-compiler.5.2.1
RUN opam source ocaml-base-compiler.5.3.0
RUN opam source ocaml-base-compiler.5.4.0
FROM ocaml/opam:alpine-3.20-opam AS alpine-3.20
ENV OPAMYES="1" OPAMCONFIRMLEVEL="unsafe-yes" OPAMERRLOGLEN="0" OPAMPRECISETRACKING="1"
RUN git -C opam-repository fetch origin && git -C opam-repository checkout c603e596bfaf195a5c1a3baf992b11c1de5ad35b && sudo ln -f /usr/bin/opam-2.3 /usr/bin/opam && opam update && rm -rf .opam/download-cache
COPY --from=cache --chown=opam:opam /home/opam/.opam/download-cache /home/opam/.opam/download-cache

FROM alpine-3.20 AS alpine-3.07
RUN opam switch create ocaml ocaml-base-compiler.3.07+2
RUN opam exec -- ocamlopt -v | head -n 1 > /home/opam/vnum

